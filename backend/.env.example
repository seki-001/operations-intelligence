# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=development
# Long random string; the dashboard sends it as X-API-Key. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=

# SQLite for local use; Postgres in production, e.g. postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./operations_intelligence.db

# csv (bundled synthetic data) | google_sheets (service account, recommended)
# | google_sheets_link (sheet shared "Anyone with the link: Viewer", no key; demo data only)
DATA_SOURCE=csv
CSV_PATH=../data/synthetic_daily_ops.csv

GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=daily_ops!A1:L
# link mode only: the tab id after "#gid=" in the sheet URL
GOOGLE_SHEET_GID=0
# Use ONE of these. On hosts without a filesystem, paste the whole JSON key into the second.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# template = no model, clearly labelled. openai_compatible = Groq, Google AI Studio, OpenRouter, Ollama...
AI_PROVIDER=template
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=

CORS_ORIGINS=http://localhost:3000
